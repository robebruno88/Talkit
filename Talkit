          <input type="password" id="customApiKeyInput" placeholder="Inserisci la tua API Key..." class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500 font-mono">
