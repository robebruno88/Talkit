  <script>
    /* Application State Variables */
    let recognition = null;
    let isRecording = false;
    let audioSource = 'mic'; // 'mic' or 'tab'
    let mediaStream = null;
    let audioContext = null;
    let analyser = null;
    let animFrame = null;
    let startTime = null;
    let timerInterval = null;

    // AI Configuration State
    let aiConfig = {
      provider: localStorage.getItem('meetscribe_provider') || 'gemini',
      apiKey: localStorage.getItem('meetscribe_apikey') || '',
      openaiModel: localStorage.getItem('meetscribe_openai_model') || 'gpt-4o-mini'
    };

    window.onload = function() {
      initSpeechRecognition();
      loadSettingsUI();
      updateWordCount();
    };

    function initSpeechRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      
      if (!SpeechRecognition) {
        showToast("Il tuo browser non supporta la Web Speech API. Usa Google Chrome, Edge o Safari.", "error");
        return;
      }

      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = document.getElementById('langSelect').value;

      document.getElementById('langSelect').addEventListener('change', (e) => {
        if (recognition) recognition.lang = e.target.value;
      });

      recognition.onstart = () => {
        isRecording = true;
        updateUIState(true);
        startTimer();
      };

      recognition.onresult = (event) => {
        let interimTranscript = '';
        let finalTranscriptChunk = '';

        for (let i = event.resultIndex; i < event.results.length; ++i) {
          const transcriptText = event.results[i][0].transcript;
          if (event.results[i].isFinal) {
            finalTranscriptChunk += transcriptText + ' ';
          } else {
            interimTranscript += transcriptText;
          }
        }

        const textarea = document.getElementById('transcriptTextarea');
        if (finalTranscriptChunk) {
          textarea.value += finalTranscriptChunk;
          updateWordCount();
          textarea.scrollTop = textarea.scrollHeight;
        }

        const interimBox = document.getElementById('interimBox');
        const interimText = document.getElementById('interimText');
        if (interimTranscript.trim().length > 0) {
          interimBox.classList.remove('hidden');
          interimText.textContent = interimTranscript;
        } else {
          interimBox.classList.add('hidden');
        }
      };

      recognition.onerror = (event) => {
        console.warn('Speech recognition error:', event.error);
        if (event.error === 'not-allowed') {
          showToast("Permesso microfono/audio negato dal browser.", "error");
          stopRecording();
        }
      };

      recognition.onend = () => {
        // Automatically restart if user hasn't explicitly stopped recording
        if (isRecording) {
          try {
            recognition.start();
          } catch(e) {
            console.error('Error auto-restarting speech recognition:', e);
          }
        } else {
          updateUIState(false);
          stopTimer();
        }
      };
    }

    function setAudioSource(source) {
      if (isRecording) {
        showToast("Interrompi la trascrizione prima di cambiare sorgente audio.", "warning");
        return;
      }
      audioSource = source;
      const micBtn = document.getElementById('srcMicBtn');
      const tabBtn = document.getElementById('srcTabBtn');

      if (source === 'mic') {
        micBtn.className = "flex-1 px-3 py-1.5 rounded-lg font-medium transition flex items-center justify-center space-x-1.5 bg-blue-600 text-white shadow-sm";
        tabBtn.className = "flex-1 px-3 py-1.5 rounded-lg font-medium transition flex items-center justify-center space-x-1.5 text-slate-400 hover:text-slate-200";
      } else {
        tabBtn.className = "flex-1 px-3 py-1.5 rounded-lg font-medium transition flex items-center justify-center space-x-1.5 bg-blue-600 text-white shadow-sm";
        micBtn.className = "flex-1 px-3 py-1.5 rounded-lg font-medium transition flex items-center justify-center space-x-1.5 text-slate-400 hover:text-slate-200";
      }
    }

    async function toggleRecording() {
      if (isRecording) {
        stopRecording();
      } else {
        await startRecording();
      }
    }

    async function startRecording() {
      if (!recognition) {
        showToast("Riconoscimento vocale non disponibile nel browser.", "error");
        return;
      }

      try {
        if (audioSource === 'tab') {
          // Capture System Audio / Screen Sharing Audio for Zoom, Meet, Teams
          mediaStream = await navigator.mediaDevices.getDisplayMedia({
            video: true,
            audio: { echoCancellation: true, noiseSuppression: true }
          });

          // Verify if user selected audio share
          const audioTracks = mediaStream.getAudioTracks();
          if (audioTracks.length === 0) {
            showToast("Hai condiviso lo schermo senza abilitare l'opzione 'Condividi Audio'. La trascrizione potrebbe non rilevare l'audio remoto.", "warning");
          }
        } else {
          // Microphone Capture
          mediaStream = await navigator.mediaDevices.getUserMedia({
            audio: { echoCancellation: true, noiseSuppression: true }
          });
        }

        // Setup Visualizer
        setupAudioVisualizer(mediaStream);

        // Start Speech Recognition
        recognition.lang = document.getElementById('langSelect').value;
        recognition.start();
        isRecording = true;

      } catch (err) {
        console.error("Error accessing audio stream:", err);
        showToast("Impossibile avviare la cattura audio. Assicurati di aver concesso i permessi.", "error");
      }
    }

    function stopRecording() {
      isRecording = false;
      if (recognition) {
        try { recognition.stop(); } catch(e) {}
      }
      if (mediaStream) {
        mediaStream.getTracks().forEach(track => track.stop());
        mediaStream = null;
      }
      if (audioContext) {
        audioContext.close();
        audioContext = null;
      }
      if (animFrame) cancelAnimationFrame(animFrame);
      document.getElementById('volumeMeter').style.width = '0%';
      document.getElementById('interimBox').classList.add('hidden');
      updateUIState(false);
      stopTimer();
    }

    function setupAudioVisualizer(stream) {
      try {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        analyser = audioContext.createAnalyser();
        analyser.fftSize = 64;
        const source = audioContext.createMediaStreamSource(stream);
        source.connect(analyser);

        const dataArray = new Uint8Array(analyser.frequencyBinCount);
        const meter = document.getElementById('volumeMeter');

        function drawMeter() {
          if (!isRecording) return;
          analyser.getByteFrequencyData(dataArray);
          let sum = 0;
          for (let i = 0; i < dataArray.length; i++) {
            sum += dataArray[i];
          }
          const average = sum / dataArray.length;
          const percentage = Math.min(100, Math.round((average / 128) * 100));
          meter.style.width = percentage + '%';
          animFrame = requestAnimationFrame(drawMeter);
        }
        drawMeter();
      } catch (e) {
        console.warn("Could not start visualizer:", e);
      }
    }

    function startTimer() {
      startTime = Date.now();
      timerInterval = setInterval(() => {
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        const hrs = String(Math.floor(elapsed / 3600)).padStart(2, '0');
        const mins = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
        const secs = String(elapsed % 60).padStart(2, '0');
        document.getElementById('timerText').textContent = `${hrs}:${mins}:${secs}`;
      }, 1000);
    }

    function stopTimer() {
      clearInterval(timerInterval);
    }

    function updateUIState(active) {
      const recordBtnText = document.getElementById('recordBtnText');
      const recordBtnIcon = document.getElementById('recordBtnIcon');
      const toggleRecordBtn = document.getElementById('toggleRecordBtn');
      const recordingBadge = document.getElementById('recordingBadge');

      if (active) {
        recordBtnText.textContent = "Interrompi";
        recordBtnIcon.className = "fa-solid fa-square";
        toggleRecordBtn.className = "px-4 py-2 rounded-xl font-medium text-xs sm:text-sm bg-red-600 hover:bg-red-500 text-white shadow-lg shadow-red-600/25 transition flex items-center space-x-2";
        recordingBadge.className = "h-2.5 w-2.5 rounded-full bg-red-500 pulse-ring";
      } else {
        recordBtnText.textContent = "Avvia Trascrizione";
        recordBtnIcon.className = "fa-solid fa-play";
        toggleRecordBtn.className = "px-4 py-2 rounded-xl font-medium text-xs sm:text-sm bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/25 transition flex items-center space-x-2";
        recordingBadge.className = "h-2.5 w-2.5 rounded-full bg-slate-500";
      }
    }

    function updateWordCount() {
      const text = document.getElementById('transcriptTextarea').value.trim();
      const words = text ? text.split(/\s+/).length : 0;
      document.getElementById('wordCountBadge').textContent = `${words} parole`;
    }

    function searchTranscript() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      const textarea = document.getElementById('transcriptTextarea');
      if (!query) return;

      const text = textarea.value;
      const index = text.toLowerCase().indexOf(query);
      if (index !== -1) {
        textarea.focus();
        textarea.setSelectionRange(index, index + query.length);
      }
    }

    function clearTranscript() {
      if (confirm("Sei sicuro di voler cancellare l'intera trascrizione?")) {
        document.getElementById('transcriptTextarea').value = '';
        updateWordCount();
      }
    }

    async function generateAISummary() {
      const text = document.getElementById('transcriptTextarea').value.trim();
      if (!text || text.length < 15) {
        showToast("Fornisci una trascrizione più lunga per generare un riassunto efficace.", "warning");
        return;
      }

      const aiBtnIcon = document.getElementById('aiBtnIcon');
      const aiBtnText = document.getElementById('aiBtnText');
      const generateAiBtn = document.getElementById('generateAiBtn');
      const placeholder = document.getElementById('summaryPlaceholder');
      const outputBox = document.getElementById('summaryOutput');
      const textContent = document.getElementById('summaryTextContent');

      // Set Loading UI
      aiBtnIcon.className = "fa-solid fa-spinner fa-spin";
      aiBtnText.textContent = "Elaborazione...";
      generateAiBtn.disabled = true;

      const template = document.getElementById('summaryTemplate').value;
      let promptInstruction = "Sei un assistente IA esperto nella redazione di verbali di riunione.";

      if (template === 'full') {
        promptInstruction += " Fornisci un verbale strutturato con: 1. Sintesi Esecutiva, 2. Punti Chiave Discussi, 3. Decisioni Prese, 4. Action Items (Azioni pratiche con eventuale responsabile).";
      } else if (template === 'executive') {
        promptInstruction += " Fornisci un breve riassunto esecutivo in 3-4 paragrafi chiari e concisi.";
      } else if (template === 'actions') {
        promptInstruction += " Estrai ed elenca esclusivamente le Azioni da svolgere (Action Items), i compiti ed eventuali responsabili o scadenze emersi.";
      } else {
        promptInstruction += " Trasforma la trascrizione grezza in note ordinate con elenchi puntati chiare ed essenziali.";
      }

      const fullPrompt = `${promptInstruction}\n\nEcco il testo della trascrizione della riunione:\n\n${text}`;

      try {
        let resultText = "";

        if (aiConfig.provider === 'gemini') {
          // Gemini API Call
          const apiKey = aiConfig.apiKey || ""; // Default Canvas API key if empty
          const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

          const payload = {
            contents: [{ parts: [{ text: fullPrompt }] }],
            systemInstruction: { parts: [{ text: "Rispondi in italiano con formattazione pulita ed elegante in formato testo." }] }
          };

          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (!response.ok) {
            throw new Error(`Errore API Gemini (${response.status})`);
          }

          const data = await response.json();
          resultText = data.candidates?.[0]?.content?.parts?.[0]?.text || "Nessun risultato generato dall'IA.";

        } else {
          // OpenAI API Call
          if (!aiConfig.apiKey) {
            showToast("Inserisci la tua API Key di OpenAI nelle Impostazioni IA.", "error");
            openModal('settingsModal');
            throw new Error("API Key OpenAI mancante.");
          }

          const response = await fetch('https://api.openai.com/v1/chat/completions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${aiConfig.apiKey}`
            },
            body: JSON.stringify({
              model: aiConfig.openaiModel || 'gpt-4o-mini',
              messages: [
                { role: 'system', content: 'Sei un assistente specializzato in riassunti di riunioni in lingua italiana.' },
                { role: 'user', content: fullPrompt }
              ]
            })
          });

          if (!response.ok) {
            throw new Error(`Errore API OpenAI (${response.status})`);
          }

          const data = await response.json();
          resultText = data.choices?.[0]?.message?.content || "Nessun risultato dall'IA.";
        }

        // Render AI Result
        placeholder.classList.add('hidden');
        outputBox.classList.remove('hidden');
        textContent.textContent = resultText;

      } catch (err) {
        console.error("AI Generation Error:", err);
        showToast("Errore durante la generazione del riassunto IA: " + err.message, "error");
      } finally {
        aiBtnIcon.className = "fa-solid fa-sparkles";
        aiBtnText.textContent = "Genera Riassunto";
        generateAiBtn.disabled = false;
      }
    }

    function exportData(type) {
      const transcript = document.getElementById('transcriptTextarea').value;
      const summary = document.getElementById('summaryTextContent').textContent;

      if (!transcript && !summary) {
        showToast("Nessun contenuto da esportare.", "warning");
        return;
      }

      const dateStr = new Date().toISOString().slice(0, 10);
      const filename = `verbale_riunione_${dateStr}`;

      if (type === 'txt') {
        const fullContent = `=== TRASCRIZIONE RIUNIONE (${dateStr}) ===\n\n${transcript}\n\n=== VERBALE E SINTESI IA ===\n\n${summary}`;
        downloadFile(fullContent, `${filename}.txt`, 'text/plain');
      } else if (type === 'md') {
        const markdownContent = `# Verbale di Riunione - ${dateStr}\n\n## 📝 Trascrizione\n${transcript}\n\n## 🤖 Sintesi & Verbale IA\n${summary}`;
        downloadFile(markdownContent, `${filename}.md`, 'text/markdown');
      } else if (type === 'print') {
        const printWindow = window.open('', '_blank');
        printWindow.document.write(`
          <html>
            <head>
              <title>Verbale Riunione - ${dateStr}</title>
              <style>
                body { font-family: system-ui, sans-serif; padding: 2rem; color: #111; line-height: 1.6; }
                h1 { color: #1e3a8a; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem; }
                h2 { color: #2563eb; margin-top: 1.5rem; }
                pre { background: #f8fafc; padding: 1rem; border-radius: 8px; white-space: pre-wrap; font-family: inherit; }
              </style>
            </head>
            <body>
              <h1>Verbale di Riunione</h1>
              <p><strong>Data:</strong> ${new Date().toLocaleDateString('it-IT')}</p>
              <h2>Sintesi IA & Action Items</h2>
              <pre>${summary || "Nessun riassunto generato."}</pre>
              <h2>Trascrizione Integrale</h2>
              <pre>${transcript || "Nessuna trascrizione registrata."}</pre>
              <script>window.onload = function() { window.print(); }<\/script>
            </body>
          </html>
        `);
        printWindow.document.close();
      }
    }

    function downloadFile(content, fileName, contentType) {
      const a = document.createElement('a');
      const file = new Blob([content], { type: contentType });
      a.href = URL.createObjectURL(file);
      a.download = fileName;
      a.click();
      URL.revokeObjectURL(a.href);
    }

    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }

    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    function toggleProviderInput() {
      const provider = document.getElementById('aiProviderSelect').value;
      const openaiModelContainer = document.getElementById('openaiModelContainer');
      
      if (provider === 'openai') {
        openaiModelContainer.classList.remove('hidden');
      } else {
        openaiModelContainer.classList.add('hidden');
      }
    }

    function loadSettingsUI() {
      document.getElementById('aiProviderSelect').value = aiConfig.provider;
      document.getElementById('customApiKeyInput').value = aiConfig.apiKey;
      document.getElementById('openaiModelSelect').value = aiConfig.openaiModel;
      toggleProviderInput();
    }

    function saveSettings() {
      aiConfig.provider = document.getElementById('aiProviderSelect').value;
      aiConfig.apiKey = document.getElementById('customApiKeyInput').value.trim();
      aiConfig.openaiModel = document.getElementById('openaiModelSelect').value;

      localStorage.setItem('meetscribe_provider', aiConfig.provider);
      localStorage.setItem('meetscribe_apikey', aiConfig.apiKey);
      localStorage.setItem('meetscribe_openai_model', aiConfig.openaiModel);

      showToast("Configurazione salvata con successo!", "success");
      closeModal('settingsModal');
    }

    /* Simple Toast Notification */
    function showToast(message, type = "info") {
      const toast = document.createElement('div');
      let bgColor = "bg-slate-800 text-white";
      if (type === "error") bgColor = "bg-red-600 text-white";
      if (type === "warning") bgColor = "bg-amber-600 text-white";
      if (type === "success") bgColor = "bg-emerald-600 text-white";

      toast.className = `fixed bottom-4 right-4 px-4 py-2.5 rounded-xl text-xs font-medium shadow-xl z-50 transition-all duration-300 transform translate-y-2 ${bgColor}`;
      toast.textContent = message;

      document.body.appendChild(toast);
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-4');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }
  </script>
