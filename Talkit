<!DOCTYPE html>
<html lang="it" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MeetScribe AI - Live Transcription & AI Summaries</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              50: '#f0f6ff',
              100: '#e0edff',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              900: '#1e3a8a',
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Custom Scrollbars */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
    ::-webkit-scrollbar-thumb { background: rgba(51, 65, 85, 0.8); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(71, 85, 105, 1); }
    .pulse-ring {
      animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse-ring {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.08); }
    }
  </style>
</head>
<body class="h-full flex flex-col font-sans bg-slate-950 text-slate-100 antialiased overflow-hidden">

  <header class="h-16 border-b border-slate-800 bg-slate-900/80 backdrop-blur px-4 lg:px-6 flex items-center justify-between z-20 shrink-0">
    <div class="flex items-center space-x-3">
      <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/20">
        <i class="fa-solid font-bold fa-waveform text-white text-lg"></i>
      </div>
      <div>
        <h1 class="text-lg font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-blue-400">
          MeetScribe AI
        </h1>
        <p class="text-xs text-slate-400 hidden sm:block">Trascrizione Live Riunioni & Sintesi Intelligente</p>
      </div>
    </div>

    <!-- Top Action Buttons -->
    <div class="flex items-center space-x-2 sm:space-x-3">
      <!-- GitHub Pages Deploy Guide Trigger -->
      <button onclick="openModal('deployModal')" class="px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-lg border border-slate-700 transition flex items-center space-x-1.5">
        <i class="fa-brands fa-github text-sm"></i>
        <span class="hidden md:inline">Guida Hosting GitHub</span>
      </button>

      <!-- Settings / API Keys Modal Trigger -->
      <button onclick="openModal('settingsModal')" class="px-3 py-1.5 text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-lg border border-slate-700 transition flex items-center space-x-1.5">
        <i class="fa-solid fa-key text-amber-400 text-sm"></i>
        <span class="hidden sm:inline">Configura API IA</span>
      </button>
    </div>
  </header>

  <main class="flex-1 flex flex-col lg:flex-row overflow-hidden relative">

    <!-- LEFT PANEL: Recording Controls & Transcript -->
    <section class="flex-1 flex flex-col border-b lg:border-b-0 lg:border-r border-slate-800 bg-slate-950/50 min-h-0">

      <!-- Control Toolbar & Audio Source Picker -->
      <div class="p-4 border-b border-slate-800 bg-slate-900/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shrink-0">
        <!-- Audio Source Selector -->
        <div class="flex items-center space-x-2 bg-slate-950 border border-slate-800 p-1 rounded-xl text-xs">
          <button id="srcMicBtn" onclick="setAudioSource('mic')" class="flex-1 px-3 py-1.5 rounded-lg font-medium transition flex items-center justify-center space-x-1.5 bg-blue-600 text-white shadow-sm">
            <i class="fa-solid fa-microphone"></i>
            <span>Microfono</span>
          </button>
          <button id="srcTabBtn" onclick="setAudioSource('tab')" class="flex-1 px-3 py-1.5 rounded-lg font-medium transition flex items-center justify-center space-x-1.5 text-slate-400 hover:text-slate-200">
            <i class="fa-solid fa-desktop"></i>
            <span>Tab/Meet/Zoom</span>
          </button>
        </div>

        <!-- Recording & Timer Controls -->
        <div class="flex items-center space-x-3">
          <!-- Live Status Indicator & Timer -->
          <div class="flex items-center space-x-2 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs font-mono">
            <span id="recordingBadge" class="h-2.5 w-2.5 rounded-full bg-slate-500"></span>
            <span id="timerText" class="text-slate-300 font-semibold">00:00:00</span>
          </div>

          <!-- Main Start/Stop Button -->
          <button id="toggleRecordBtn" onclick="toggleRecording()" class="px-4 py-2 rounded-xl font-medium text-xs sm:text-sm bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/25 transition flex items-center space-x-2">
            <i id="recordBtnIcon" class="fa-solid fa-play"></i>
            <span id="recordBtnText">Avvia Trascrizione</span>
          </button>
        </div>
      </div>

      <!-- Real-Time Visualizer Bar & Search -->
      <div class="px-4 py-2.5 border-b border-slate-800/60 bg-slate-900/20 flex items-center justify-between gap-3 text-xs shrink-0">
        <!-- Live Waveform Visualizer -->
        <div class="flex items-center space-x-3 flex-1 max-w-xs">
          <span class="text-slate-500 font-medium text-[11px] uppercase tracking-wider">Audio Input</span>
          <div class="flex-1 h-3 bg-slate-900 rounded-full overflow-hidden border border-slate-800/80 relative flex items-center px-0.5">
            <div id="volumeMeter" class="h-1.5 bg-gradient-to-r from-blue-500 to-emerald-400 rounded-full transition-all duration-75 w-0"></div>
          </div>
        </div>

        <!-- Language Selector -->
        <div class="flex items-center space-x-2">
          <label for="langSelect" class="text-slate-400 text-xs hidden sm:inline">Lingua:</label>
          <select id="langSelect" class="bg-slate-900 border border-slate-800 text-slate-300 text-xs rounded-lg px-2 py-1 focus:outline-none focus:border-blue-500">
            <option value="it-IT" selected>Italiano 🇮🇹</option>
            <option value="en-US">English (US) 🇺🇸</option>
            <option value="es-ES">Español 🇪🇸</option>
            <option value="fr-FR">Français 🇫🇷</option>
            <option value="de-DE">Deutsch 🇩🇪</option>
          </select>
        </div>
      </div>

      <!-- Transcript Container Header -->
      <div class="px-4 py-2 bg-slate-900/30 flex items-center justify-between border-b border-slate-800/40 text-xs shrink-0">
        <div class="flex items-center space-x-2 text-slate-400">
          <i class="fa-solid fa-align-left text-blue-400"></i>
          <span class="font-medium text-slate-300">Trascrizione in tempo reale</span>
          <span id="wordCountBadge" class="bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full text-[10px]">0 parole</span>
        </div>
        
        <!-- Transcript Search & Clear Controls -->
        <div class="flex items-center space-x-2">
          <div class="relative">
            <input type="text" id="searchInput" oninput="searchTranscript()" placeholder="Cerca nel testo..." class="bg-slate-900 border border-slate-800 text-slate-200 text-xs rounded-lg pl-7 pr-2 py-1 w-36 sm:w-48 focus:outline-none focus:border-blue-500">
            <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-1.5 text-slate-500 text-[10px]"></i>
          </div>
          <button onclick="clearTranscript()" title="Cancella trascrizione" class="p-1.5 text-slate-400 hover:text-red-400 rounded-lg hover:bg-slate-800 transition">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
      </div>

      <!-- Transcript Editor Body -->
      <div class="flex-1 p-4 overflow-y-auto relative flex flex-col">
        <textarea id="transcriptTextarea" oninput="updateWordCount()" placeholder="Inizia a parlare o seleziona una scheda del browser da condividere per trascrivere la riunione..." class="w-full flex-1 bg-transparent text-slate-200 placeholder-slate-600 focus:outline-none resize-none font-sans text-sm sm:text-base leading-relaxed tracking-wide"></textarea>
        
        <!-- Live Speech Visual Interim Feedback -->
        <div id="interimBox" class="mt-2 text-xs italic text-blue-400/80 bg-blue-950/20 p-2 rounded-lg border border-blue-900/30 min-h-[2rem] hidden">
          <i class="fa-solid fa-spinner fa-spin mr-1"></i> <span id="interimText">Ascolto...</span>
        </div>
      </div>

    </section>

    <!-- RIGHT PANEL: AI Summary & Action Items -->
    <section class="flex-1 flex flex-col bg-slate-900/30 min-h-0">

      <!-- AI Action Bar -->
      <div class="p-4 border-b border-slate-800 bg-slate-900/60 flex flex-wrap items-center justify-between gap-3 shrink-0">
        <div class="flex items-center space-x-2">
          <div class="h-8 w-8 rounded-lg bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
          </div>
          <div>
            <h2 class="text-sm font-semibold text-slate-200">Sintesi & Verbale IA</h2>
            <p class="text-[11px] text-slate-400">Genera report con punti chiave e azioni</p>
          </div>
        </div>

        <div class="flex items-center space-x-2">
          <!-- Summary Preset Dropdown -->
          <select id="summaryTemplate" class="bg-slate-950 border border-slate-800 text-slate-300 text-xs rounded-xl px-2.5 py-1.5 focus:outline-none focus:border-indigo-500">
            <option value="full" selected>Verbale Completo (Punti, Decisioni, Action Items)</option>
            <option value="executive">Sintesi Esecutiva (Breve)</option>
            <option value="actions">Solo Action Items & Assegnazioni</option>
            <option value="notes">Note informali di riunione</option>
          </select>

          <!-- Generate Summary Button -->
          <button id="generateAiBtn" onclick="generateAISummary()" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white shadow-md shadow-indigo-600/20 transition flex items-center space-x-1.5">
            <i id="aiBtnIcon" class="fa-solid fa-sparkles"></i>
            <span id="aiBtnText">Genera Riassunto</span>
          </button>
        </div>
      </div>

      <!-- AI Summary Content Output -->
      <div class="flex-1 p-4 overflow-y-auto relative flex flex-col">
        <!-- Placeholder Empty State -->
        <div id="summaryPlaceholder" class="m-auto text-center max-w-sm py-8 px-4">
          <div class="w-12 h-12 rounded-2xl bg-slate-800/80 border border-slate-700/50 flex items-center justify-center text-slate-500 mx-auto mb-3">
            <i class="fa-solid fa-file-contract text-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-slate-300 mb-1">Nessun riassunto generato</h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            Avvia la trascrizione della riunione, quindi premi "Genera Riassunto" per ottenere la sintesi con punti chiave ed azioni da svolgere.
          </p>
          <button onclick="openModal('settingsModal')" class="inline-flex items-center space-x-1 text-xs text-blue-400 hover:underline">
            <i class="fa-solid fa-gear"></i>
            <span>Verifica o modifica la tua API Key Gemini / OpenAI</span>
          </button>
        </div>

        <!-- AI Output Box -->
        <div id="summaryOutput" class="hidden flex-1 flex flex-col space-y-4">
          <div class="p-4 rounded-xl bg-slate-900/90 border border-slate-800 text-slate-200 text-sm leading-relaxed whitespace-pre-wrap font-sans overflow-y-auto" id="summaryTextContent"></div>
        </div>
      </div>

      <!-- Export Bottom Bar -->
      <div class="p-3 border-t border-slate-800 bg-slate-900/80 flex items-center justify-between text-xs shrink-0">
        <span class="text-slate-400">Esporta Verbale:</span>
        <div class="flex items-center space-x-2">
          <button onclick="exportData('txt')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition flex items-center space-x-1 border border-slate-700">
            <i class="fa-solid fa-file-lines text-slate-400"></i>
            <span>TXT</span>
