    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
      <button onclick="closeModal('settingsModal')" class="absolute top-4 right-4 text-slate-500 hover:text-slate-300">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>

      <div class="flex items-center space-x-3 mb-4">
        <div class="h-10 w-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400">
          <i class="fa-solid fa-sliders text-lg"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-100">Configurazione IA</h3>
          <p class="text-xs text-slate-400">Seleziona e configura la chiave API per le sintesi</p>
        </div>
