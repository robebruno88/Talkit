<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trascrizione Live & Riassunto IA</title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; color: #1f2937; }
    h1 { color: #111827; }
    .controls { margin-bottom: 1.5rem; display: flex; gap: 10px; align-items: center; }
    button { padding: 0.6rem 1.2rem; border-radius: 6px; border: none; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .btn-start { background-color: #2563eb; color: white; }
    .btn-start:hover { background-color: #1d4ed8; }
    .btn-stop { background-color: #dc2626; color: white; }
    .btn-stop:hover { background-color: #b91c1c; }
    .btn-ai { background-color: #059669; color: white; }
    .btn-ai:hover { background-color: #047857; }
    .status { font-weight: 500; font-size: 0.9rem; color: #4b5563; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1rem; }
    @media (max-width: 768px) { .grid { grid-template-columns: 1fr; } }
    .box { border: 1px solid #e5e7eb; border-radius: 8px; padding: 1rem; background: #fafafa; min-height: 300px; display: flex; flex-direction: column; }
    .box h2 { font-size: 1.1rem; margin-top: 0; }
    textarea, .content { flex: 1; border: 1px solid #d1d5db; border-radius: 6px; padding: 0.75rem; font-family: inherit; font-size: 0.95rem; resize: vertical; background: white; }
    input[type="password"] { padding: 0.5rem; border-radius: 4px; border: 1px solid #ccc; width: 250px; }
  </style>
</head>
<body>

  <h1>Trascrizione Riunioni Live & Riassunto IA</h1>

  <div class="controls">
    <button id="startBtn" class="btn-start" onclick="startRecognition()">Avvia Trascrizione</button>
    <button id="stopBtn" class="btn-stop" onclick="stopRecognition()" disabled>Interrompi</button>
    <span id="status" class="status">Stato: Inattivo</span>
  </div>

  <div style="margin-bottom: 1rem;">
    <label for="apiKey"><strong>Chiave API OpenAI (per il riassunto):</strong></label>
    <input type="password" id="apiKey" placeholder="sk-..." />
  </div>

  <div class="grid">
    <div class="box">
      <h2>Trascrizione Live</h2>
      <textarea id="transcript" placeholder="La trascrizione apparirà qui mentre parli..."></textarea>
    </div>
    <div class="box">
      <h2>Riassunto IA</h2>
      <button class="btn-ai" style="margin-bottom: 0.75rem;" onclick="generateSummary()">Genera Riassunto con IA</button>
      <div id="summary" class="content" style="overflow-y: auto;">Il riassunto apparirà qui...</div>
    </div>
  </div>

  <script>
    let recognition;
    let isListening = false;
    const transcriptEl = document.getElementById('transcript');
    const statusEl = document.getElementById('status');
    const startBtn = document.getElementById('startBtn');
    const stopBtn = document.getElementById('stopBtn');

    // Inizializzazione Speech Recognition
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = 'it-IT';

      recognition.onresult = (event) => {
        let currentTranscript = '';
        for (let i = event.resultIndex; i < event.results.length; ++i) {
          currentTranscript += event.results[i][0].transcript;
        }
        transcriptEl.value += currentTranscript + ' ';
      };

      recognition.onerror = (event) => {
        console.error('Errore riconoscimento vocale:', event.error);
        statusEl.textContent = 'Errore: ' + event.error;
      };

      recognition.onend = () => {
        if (isListening) {
          recognition.start(); // Riavvia automaticamente in caso di timeout
        } else {
          statusEl.textContent = 'Stato: Inattivo';
        }
      };
    } else {
      alert('Il tuo browser non supporta la Web Speech API. Usa Chrome o Edge.');
    }

    function startRecognition() {
      if (recognition) {
        isListening = true;
        recognition.start();
        startBtn.disabled = true;
        stopBtn.disabled = false;
        statusEl.textContent = 'Stato: In ascolto...';
      }
    }

    function stopRecognition() {
      if (recognition) {
        isListening = false;
        recognition.stop();
        startBtn.disabled = false;
        stopBtn.disabled = true;
        statusEl.textContent = 'Stato: Interrotto';
      }
    }

    async function generateSummary() {
      const apiKey = document.getElementById('apiKey').value.trim();
      const text = transcriptEl.value.trim();
      const summaryEl = document.getElementById('summary');

      if (!text) {
        alert('Nessun testo da riassumere.');
        return;
      }
      if (!apiKey) {
        alert('Inserisci la tua chiave API OpenAI.');
        return;
      }

      summaryEl.textContent = 'Generazione riassunto in corso...';

      try {
        const response = await fetch('https://api.openai.com/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${apiKey}`
          },
          body: JSON.stringify({
            model: 'gpt-4o-mini',
            messages: [
              {
                role: 'system',
                content: 'Sei un assistente specializzato nel sintetizzare le riunioni. Analizza il testo della trascrizione e fornisci: 1) Un breve riassunto esecutivo, 2) I punti chiave discussi, 3) Le decisioni prese e le azioni da compiere (Action Items).'
              },
              {
                role: 'user',
                content: `Ecco la trascrizione della riunione:\n\n${text}`
              }
            ]
          })
        });

        const data = await response.json();
        if (data.choices && data.choices[0]) {
          summaryEl.innerText = data.choices[0].message.content;
        } else {
          summaryEl.textContent = 'Errore nella risposta: ' + JSON.stringify(data);
        }
      } catch (err) {
        console.error(err);
        summaryEl.textContent = 'Si è verificato un errore durante la chiamata all\'API.';
      }
    }
  </script>
</body>
</html>
