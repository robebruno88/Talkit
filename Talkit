          <button onclick="exportData('md')" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition flex items-center space-x-1 border border-slate-700">
            <i class="fa-brands fa-markdown text-blue-400"></i>
            <span>Markdown</span>
          </button>
          <button onclick="exportData('print')" class="px-2.5 py-1 rounded-lg bg-indigo-600/80 hover:bg-indigo-600 text-white transition flex items-center space-x-1">
            <i class="fa-solid fa-print"></i>
            <span>Stampa / PDF</span>
          </button>
        </div>
      </div>

    </section>
  </main>

